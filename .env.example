# Database
DATABASE_URL=postgresql+asyncpg://ridepilot:ridepilot@postgres:5432/ridepilot

# Service URLs (used for inter-service communication)
AI_SERVICE_URL=http://ai-service:8001
QUOTE_SERVICE_URL=http://quote-service:8002
BOOKING_SERVICE_URL=http://booking-service:8003
MOCK_PROVIDERS_URL=http://mock-providers:8004

# AI / LLM provider (OpenAI-compatible)
# Leave OPENAI_API_KEY as the placeholder AND OPENAI_BASE_URL empty to run in the
# no-key stub mode (deterministic, no real model — good for a first run).
#
# The AI Service talks to any OpenAI-compatible endpoint, so you switch providers
# with config alone:
#
#   Free local testing with Ollama (open-source models, no key required):
#     OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#     OPENAI_MODEL=llama3.1
#   (install Ollama on the host and run `ollama pull llama3.1` first. From a
#    container reach the host via host.docker.internal; if you run Ollama as a
#    compose service instead, use http://ollama:11434/v1. Pick a tool-calling
#    capable model, e.g. llama3.1, qwen2.5, or mistral-nemo.)
#
#   Paid / hosted OpenAI:
#     OPENAI_API_KEY=sk-...
#     OPENAI_MODEL=gpt-4o-mini
#     (leave OPENAI_BASE_URL empty)
#
#   Other hosted OpenAI-compatible APIs (Groq, OpenRouter, Together, ...):
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_API_KEY=<provider key>
#     OPENAI_MODEL=<provider model id>
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Cap reply length (tokens) and sampling temperature. Lower values keep small
# local models concise and focused; tune as needed.
OPENAI_MAX_TOKENS=512
OPENAI_TEMPERATURE=0.3

# CORS — browser origins allowed to call the AI Service (comma-separated).
# The frontend runs on http://localhost:3000 in dev; add other origins as needed.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Quote monitoring
QUOTE_REFRESH_INTERVAL_SECONDS=60

# Ride status tracking (Booking Service background worker)
# How often the Booking Service polls the provider for ride status updates on
# confirmed/active bookings, in seconds.
RIDE_STATUS_POLL_INTERVAL_SECONDS=15

# Frontend (Next.js) — NEXT_PUBLIC_* vars are exposed to the browser bundle.
# The browser runs on the host, so it reaches the AI Service via the published
# host port (http://localhost:8001), not the internal compose hostname.
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_USER_ID=demo_user

# Logging — AI Service verbosity. INFO logs each turn's tool/API calls, their
# responses, and the assistant's final reply. Set DEBUG for more detail.
LOG_LEVEL=INFO
