# Database
# Postgres credentials — consumed by the postgres container (docker-compose
# interpolates these) and by DATABASE_URL below. Set real values in your local
# .env (gitignored); these placeholders must be replaced before starting.
POSTGRES_USER=ridepilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ridepilot
# Keep user/password/db in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://ridepilot:change-me@postgres:5432/ridepilot

# Service URLs (used for inter-service communication)
AI_SERVICE_URL=http://ai-service:8001
QUOTE_SERVICE_URL=http://quote-service:8002
BOOKING_SERVICE_URL=http://booking-service:8003
MOCK_PROVIDERS_URL=http://mock-providers:8004

# AI / LLM provider (LiteLLM SDK)
# The service uses direct provider SDK access; it does not read a .env file.
# Supply values to the container/runtime process environment.
#
# Gemini: use an API key you provide. The service falls back to the safe default
# model if GEMINI_MODEL is not one of the allow-listed models.
#   LLM_PROVIDER=gemini
#   GEMINI_API_KEY=<your Gemini API key>
#   GEMINI_MODEL=gemini/gemini-3.5-flash-lite
#
# Ollama: local models require no API key. Ensure the model is installed and
# reachable from the ai-service container.
#   LLM_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
#   OLLAMA_MODEL=qwen2.5:7b
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# These are hard-capped by the service: at most 256 output tokens per model call,
# 6 chat-history messages, and a 30-second request timeout.
LLM_MAX_TOKENS=128
# Gemini 3.5 should use 1.0. For Ollama, 0.3 is a reasonable starting point.
LLM_TEMPERATURE=1.0
CHAT_CONTEXT_MESSAGE_LIMIT=6

# Fixed test coordinates (AI Service). There is no address geocoding yet, so the
# system cannot know real lat/lng for a pickup/dropoff — and the LLM must never
# fabricate them. These stand-in coordinates (downtown Phoenix -> Sky Harbor
# airport) are injected whenever a coordinate is missing so quotes/bookings can
# be created. The mock providers ignore coordinates for pricing, so the values
# only need to be valid. Override to test a different locale; remove once real
# geocoding is added.
TEST_PICKUP_LAT=33.4484
TEST_PICKUP_LNG=-112.0740
TEST_DROPOFF_LAT=33.4373
TEST_DROPOFF_LNG=-112.0078

# CORS — browser origins allowed to call the AI Service (comma-separated).
# The frontend runs on http://localhost:3000 in dev; add other origins as needed.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Quote monitoring
QUOTE_REFRESH_INTERVAL_SECONDS=60

# Ride status tracking (Booking Service background worker)
# How often the Booking Service polls the provider for ride status updates on
# confirmed/active bookings, in seconds.
RIDE_STATUS_POLL_INTERVAL_SECONDS=15

# Frontend (Next.js) — NEXT_PUBLIC_* vars are exposed to the browser bundle.
# The browser runs on the host, so it reaches the AI Service via the published
# host port (http://localhost:8001), not the internal compose hostname.
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_USER_ID=demo_user

# Logging — AI Service verbosity. INFO logs each turn's tool/API calls, their
# responses, and the assistant's final reply. Set DEBUG for more detail.
LOG_LEVEL=INFO

# Trace to file (AI Service). When true, the same log lines that go to stdout are
# also written to a rotating file — a persistent, greppable trace of each turn
# (model input, tools/APIs called, final reply). OFF by default; the trace holds
# full prompts and conversation history, so treat it as a debug artifact.
# TRACE_LOG_PATH is relative to the ai-service dir, so the default lands in
# services/ai-service/logs/ (bind-mounted to the host in dev).
TRACE_TO_FILE=false
TRACE_LOG_PATH=logs/ai-service.log
TRACE_LOG_MAX_BYTES=5242880
TRACE_LOG_BACKUP_COUNT=3
